{
  "name": "@jeius-mcp-servers/pdf",
  "version": "1.0.0",
  "description": "MCP server for pdf",
  "license": "MIT",
  "author": "Julius Pahama",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pdf": "./build/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod 755 build/index.js",
    "check-types": "tsc --noEmit",
